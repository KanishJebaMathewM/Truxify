
# ==========================================
# Truxify Blockchain Module Environment
# ==========================================

# Polygon Mainnet RPC URL
POLYGON_RPC_URL=https://polygon-rpc.com/

# Polygon Amoy Testnet RPC URL
# Get an RPC URL from Alchemy or Infura
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# ==========================================
# Wallet Configuration
# ==========================================

# Relayer wallet private key (preferred)
# Use a dedicated wallet and never commit real private keys
RELAYER_PRIVATE_KEY=your_relayer_private_key_here

# Deployer private key (fallback for deployment scripts)
DEPLOYER_PRIVATE_KEY=your_testnet_wallet_private_key_here

# Initial relayer wallet address
RELAYER_WALLET_ADDRESS=your_relayer_wallet_address_here

# ==========================================
# Contract Verification
# ==========================================

# Get your API key from https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
