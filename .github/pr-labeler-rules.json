{
  "programSignals": [
    "nsoc",
    "nsoc26",
    "national student open source contribution",
    "national student open source"
  ],

  "programLabels": [
    "nsoc",
    "nsoc26"
  ],

  "inheritLabels": [
    "level:beginner",
    "level:intermediate",
    "level:advanced",
    "level:critical",
    "quality:clean",
    "quality:exceptional",
    "customer-app",
    "driver-app",
    "backend",
    "flutter",
    "blockchain",
    "ml",
    "automation",
    "dependencies",
    "nsoc",
    "nsoc26"
  ],

  "titleRules": [
    {
      "pattern": "^(fix|bug|hotfix)(\\s*[:(]|\\s+)",
      "labels": ["type:bug"]
    },
    {
      "pattern": "^(feat|feature)(\\s*[:(]|\\s+)",
      "labels": ["type:feature"]
    },
    {
      "pattern": "^refactor(\\s*[:(]|\\s+)",
      "labels": ["type:refactor"]
    },
    {
      "pattern": "^(test|tests)(\\s*[:(]|\\s+)",
      "labels": ["type:testing"]
    },
    {
      "pattern": "^(docs|doc|documentation)(\\s*[:(]|\\s+)",
      "labels": ["type:docs"]
    },
    {
      "pattern": "(^|[^a-z])(xss|csrf|ssrf|vulnerability|security|authentication|authorization|secret|token)([^a-z]|$)",
      "labels": ["type:security"]
    },
    {
      "pattern": "^(perf|performance)(\\s*[:(]|\\s+)",
      "labels": ["type:performance"]
    },
    {
      "pattern": "^(design|ui|ux)(\\s*[:(]|\\s+)",
      "labels": ["type:design"]
    },
    {
      "pattern": "^(ci|cd|devops|build|infra)(\\s*[:(]|\\s+)",
      "labels": ["type:devops"]
    },
    {
      "pattern": "^(a11y|accessibility)(\\s*[:(]|\\s+)",
      "labels": ["type:accessibility"]
    },
    {
      "pattern": "^(api)(\\s*[:(]|\\s+)",
      "labels": ["type:api"]
    }
  ],

  "pathRules": [
    {
      "pattern": "^apps/customer/",
      "labels": ["customer-app", "flutter"]
    },
    {
      "pattern": "^apps/driver/",
      "labels": ["driver-app", "flutter"]
    },
    {
      "pattern": "^backend/api/",
      "labels": ["backend", "type:api"]
    },
    {
      "pattern": "^backend/ml/",
      "labels": ["backend", "ml"]
    },
    {
      "pattern": "^backend/",
      "labels": ["backend"]
    },
    {
      "pattern": "^blockchain/",
      "labels": ["blockchain"]
    },
    {
      "pattern": "^automation/",
      "labels": ["automation"]
    },
    {
      "pattern": "(^|/)(docs/|README|CONTRIBUTING)|\\.md$",
      "labels": ["type:docs"]
    },
    {
      "pattern": "(^|/)(test|tests)/|\\.test\\.|_test\\.",
      "labels": ["type:testing"]
    },
    {
      "pattern": "(package-lock\\.json|pubspec\\.lock|dependabot\\.yml|yarn\\.lock|pnpm-lock\\.yaml)",
      "labels": ["dependencies"]
    },
    {
      "pattern": "\\.(yaml|yml)$",
      "labels": ["type:devops"]
    }
  ],

  "singleTypeLabel": true,

  "typeLabelPriority": [
    "type:security",
    "type:performance",
    "type:bug",
    "type:feature",
    "type:refactor",
    "type:api",
    "type:testing",
    "type:design",
    "type:devops",
    "type:docs",
    "type:accessibility"
  ]
}
