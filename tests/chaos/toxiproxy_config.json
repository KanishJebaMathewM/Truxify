[
  {
    "name": "postgres_chaos_proxy",
    "listen": "localhost:5433",
    "upstream": "localhost:5432",
    "enabled": true,
    "toxics": [
      {
        "type": "latency",
        "name": "db_latency_spike",
        "stream": "upstream",
        "attributes": {
          "latency": 3000,
          "jitter": 500
        }
      },
      {
        "type": "limit_data",
        "name": "db_packet_loss",
        "stream": "downstream",
        "attributes": {
          "bytes": 500
        }
      }
    ]
  }
]
