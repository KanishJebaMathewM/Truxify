    "cors": "^2.8.5",
    "dompurify": "^3.4.17",
    "dotenv": "^17.4.2",
    "ethers": "6.17.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "i18next": "^27.1.1",
    "i18next-http-middleware": "^3.10.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^7.9.0",
    "mongoose": "^9.12.1",
