{
  "name": "truxify-backend-api",
  "version": "1.0.0",
  "description": "Truxify Backend API - Node.js, Express, WebSockets",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "check-env": "node scripts/check-env.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:load:api": "k6 run tests/load/scenarios.js",
    "test:load:ws": "k6 run tests/load/websocket.js",
    "lint": "eslint . --max-warnings=0",
    "verify-db": "node scripts/verify-db-schema.js",
    "seed:dev": "node scripts/seed-dev-profile.js",
    "benchmark:postgis": "node scripts/benchmark-postgis.js",
    "benchmark:loads": "node scripts/benchmark-load-marketplace.js"
  },
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-mongodb": "^0.78.0",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/instrumentation-redis": "^0.73.0",
    "@opentelemetry/instrumentation-winston": "^0.70.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@sentry/node": "^10.75.0",
    "@supabase/supabase-js": "^2.119.0",
    "@upstash/redis": "^1.41.0",
    "axios": "^1.21.1",
    "circuit-breaker-js": "0.0.1",
    "compression": "^1.8.2",
