echo "=== Starting PR creation ==="

do_sync() {
  cd "$WORKSPACE"
  git fetch upstream main
  git reset --hard upstream/main
  # Restore our script if deleted
  if [ ! -f "$WORKSPACE/.mavis/do_pr2.sh" ]; then
    cp "$WORKSPACE/.mavis/do_pr2.sh.bu" "$WORKSPACE/.mavis/do_pr2.sh" 2>/dev/null || true
  fi
}

