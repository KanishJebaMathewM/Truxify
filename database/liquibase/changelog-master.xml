<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
      WARNING: These changelogs describe a legacy standalone demo schema
      (BIGINT ids, 'PENDING'/'OFFLINE' defaults, driver_id -> drivers(id))
      that is NOT compatible with the application schema (profiles /
      driver_details / orders with uuid ids and lowercase status CHECKs,
      owned by supabase/migrations). They must only ever be applied to the
      dedicated "truxify_liquibase" database — never to the application
      database ("truxify" or Supabase's "postgres"). All run scripts and the
      API Liquibase service enforce this with a guard.
    -->

    <!-- Include all change logs -->
    <include file="changelog-v1.0.xml" relativeToChangelogFile="true"/>
    <include file="changelog-v1.1.xml" relativeToChangelogFile="true"/>
    <include file="changelog-v1.2.xml" relativeToChangelogFile="true"/>
    <include file="changelog-v2.0.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>