  "description": "Truxify event-sourcing store: optimistic concurrency, snapshot-based replay and read-model rebuilds",
  "type": "module",
  "main": "event-store.js",
  "exports": {
    ".": "./event-store.js",
    "./core": "./event-sourcing-core.js",
    "./errors": "./errors.js"
  },
  "engines": {
    "node": ">=18.13.0"
  },
  "scripts": {
    "start": "node event-store.js",
