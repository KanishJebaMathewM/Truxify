# Docker resolves .dockerignore from the build-context root. Dockerfile.api and
# Dockerfile.ml both build with the repository root as context, so
# backend/ml/.dockerignore never applies to them and this file is what governs
# those builds.
**/__pycache__/
**/*.py[cod]
**/venv/
**/node_modules/
**/.env
**/.env.*
!**/.env.example
**/*.db
.git/
.github/
**/coverage/
**/.pytest_cache/
**/.dart_tool/
**/build/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Additional Python/Type Checking Cache
.mypy_cache/
.ruff_cache/
