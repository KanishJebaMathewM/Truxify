{
  "name": "Demand Forecast Model Auto-Rollback Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "hours": 1
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "id": "schedule-trigger",
      "name": "Schedule Check"
    },
    {
      "parameters": {
        "url": "http://ml-engine:8000/models/demand/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.ML_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [200, 0],
      "id": "check-demand-model",
      "name": "Check Active Demand Model"
    },
    {
      "parameters": {
        "url": "http://ml-engine:8000/models/demand/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.ML_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [400, 0],
      "id": "evaluate-demand-model",
      "name": "Evaluate Demand Model"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json;\nreturn {\n  model: data.model,\n  active_version: data.active_version,\n  previous_version: data.previous_version,\n  should_rollback: Boolean(data.should_rollback),\n  action: data.should_rollback ? 'rollback' : 'keep_active',\n  evaluated_at: new Date().toISOString()\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 0],
      "id": "decision-node",
      "name": "Demand Rollback Decision"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.should_rollback}}",
              "value2": true
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [800, 0],
      "id": "rollback-branch",
      "name": "Should Roll Back Demand Model?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ml-engine:8000/train/demand/rollback",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.ML_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1000, -100],
      "id": "execute-rollback",
      "name": "Restore Previous Demand Model"
    },
    {
      "parameters": {
        "toEmail": "ml-alerts@truxify.org",
        "subject": "Demand Forecast Rollback: {{$node[\"Demand Rollback Decision\"].json.active_version}}",
        "htmlFormat": true,
        "message": "<h3>Demand Forecast Rollback</h3><p>Model performance degradation was detected for active generation: <strong>{{$node[\"Demand Rollback Decision\"].json.active_version}}</strong>.</p><p>Rollback result: {{$json.rolled_back}} at {{$node[\"Demand Rollback Decision\"].json.evaluated_at}}.</p><p>The previous demand model remains active only when restoration succeeds.</p>",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1.1,
      "position": [1200, -100],
      "id": "send-alert",
      "name": "Send Demand Rollback Alert"
    }
  ],
  "connections": {
    "schedule-trigger": {
      "main": [
        [
          {
            "node": "check-demand-model",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "check-demand-model": {
      "main": [
        [
          {
            "node": "evaluate-demand-model",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "evaluate-demand-model": {
      "main": [
        [
          {
            "node": "decision-node",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "decision-node": {
      "main": [
        [
          {
            "node": "rollback-branch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "rollback-branch": {
      "main": [
        [
          {
            "node": "execute-rollback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "execute-rollback": {
      "main": [
        [
          {
            "node": "send-alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "versionId": "ml-rollback-v1",
  "id": "ml-rollback-workflow"
}
