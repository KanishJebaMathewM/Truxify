{
  "name": "Truxify Dispute Resolution Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "disputes",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "webhook-trigger",
      "name": "Supabase Dispute Webhook"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$node[\"Supabase Dispute Webhook\"].json.body.record.order_api_url}}/api/payments/{{$node[\"Supabase Dispute Webhook\"].json.body.record.id}}/status",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        200,
        0
      ],
      "id": "freeze-escrow",
      "name": "Check Escrow Status"
    },
    {
      "parameters": {
        "url": "={{$node[\"Supabase Dispute Webhook\"].json.body.record.order_api_url}}/api/orders/{{$node[\"Supabase Dispute Webhook\"].json.body.record.id}}/timeline",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        400,
        0
      ],
      "id": "fetch-evidence",
      "name": "Fetch Order Timeline"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$node[\"Supabase Dispute Webhook\"].json.body.record.order_api_url}}/api/support/tickets",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "subject",
              "value": "Dispute Opened: Delivery Unconfirmed"
            },
            {
              "name": "category",
              "value": "payment"
            },
            {
              "name": "description",
              "value": "Dispute opened for trip {{$node[\"Supabase Dispute Webhook\"].json.body.record.id}}. Evidence gathered from the order timeline."
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        600,
        0
      ],
      "id": "notify-parties",
      "name": "Open Support Ticket"
    },
    {
      "parameters": {
        "amount": 24,
        "unit": "hours"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        800,
        0
      ],
      "id": "wait-24h",
      "name": "Wait 24 Hours"
    },
    {
      "parameters": {
        "url": "={{$node[\"Supabase Dispute Webhook\"].json.body.record.order_api_url}}/api/orders/{{$node[\"Supabase Dispute Webhook\"].json.body.record.id}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1000,
        0
      ],
      "id": "check-status",
      "name": "Check Dispute Resolution Status"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.order.status}}",
              "value2": "disputed"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1200,
        0
      ],
      "id": "is-still-disputed",
      "name": "Is Still Disputed?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$node[\"Supabase Dispute Webhook\"].json.body.record.order_api_url}}/api/support/tickets",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "subject",
              "value": "Escalation: Arbitration Required for Trip"
            },
            {
              "name": "category",
              "value": "payment"
            },
            {
              "name": "description",
              "value": "Trip {{$node[\"Supabase Dispute Webhook\"].json.body.record.id}} remained disputed after 24 hours. Review the order timeline for evidence."
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1400,
        0
      ],
      "id": "escalate-admin",
      "name": "Escalate as Support Ticket"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "manual-resolution",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "id": "manual-resolution-webhook",
      "name": "Manual Resolution Webhook"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.body.record.order_api_url}}/api/payments/{{$json.body.record.id}}/status",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        200,
        200
      ],
      "id": "release-or-refund",
      "name": "Verify Escrow Release"
    }
  ],
  "connections": {
    "webhook-trigger": {
      "main": [
        [
          {
            "node": "freeze-escrow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "freeze-escrow": {
      "main": [
        [
          {
            "node": "fetch-evidence",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "fetch-evidence": {
      "main": [
        [
          {
            "node": "notify-parties",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "notify-parties": {
      "main": [
        [
          {
            "node": "wait-24h",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "wait-24h": {
      "main": [
        [
          {
            "node": "check-status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "check-status": {
      "main": [
        [
          {
            "node": "is-still-disputed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "is-still-disputed": {
      "main": [
        [
          {
            "node": "escalate-admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "manual-resolution-webhook": {
      "main": [
        [
          {
            "node": "release-or-refund",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "versionId": "dispute-resolv-v2",
  "id": "dispute-resolution-pipeline"
}
