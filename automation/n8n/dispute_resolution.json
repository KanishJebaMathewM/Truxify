{
  "name": "Truxify Dispute Resolution Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "disputes",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "webhook-trigger",
      "name": "Supabase Dispute Webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.body.record.order_api_url}}/api/contracts/freeze",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.INTERNAL_RELAYER_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "tripId",
              "value": "={{$json.body.record.id}}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        200,
        0
      ],
      "id": "freeze-escrow",
      "name": "Freeze Smart Contract Escrow",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "toEmail": "admin@truxify.com",
        "subject": "=Escrow Alert: Freeze Smart Contract Escrow Failed for Trip {{$node[\"Supabase Dispute Webhook\"].json.body.record.id}}",
        "textBody": "=CRITICAL: The Freeze Smart Contract Escrow step failed after 3 retries for Trip {{$node[\"Supabase Dispute Webhook\"].json.body.record.id}}. Smart contract payment was not frozen. Immediate manual intervention required.",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        200,
        -200
      ],
      "id": "alert-admin-freeze-failed",
      "name": "Alert Admin — Escrow Freeze Failed"
    },
    {
      "parameters": {
        "url": "={{$node[\"Supabase Dispute Webhook\"].json.body.record.order_api_url}}/api/orders/{{$node[\"Supabase Dispute Webhook\"].json.body.record.id}}/dispute-evidence",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        400,
        0
      ],
      "id": "fetch-evidence",
      "name": "Fetch GPS Trail & OTP Logs"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$node[\"Supabase Dispute Webhook\"].json.body.record.order_api_url}}/api/notifications/dispute",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "tripId",
              "value": "={{$node[\"Supabase Dispute Webhook\"].json.body.record.id}}"
            },
            {
              "name": "driverPhone",
              "value": "={{$node[\"Supabase Dispute Webhook\"].json.body.record.driver_phone}}"
            },
            {
              "name": "customerPhone",
              "value": "={{$node[\"Supabase Dispute Webhook\"].json.body.record.customer_phone}}"
            },
            {
              "name": "message",
              "value": "Dispute opened for trip. Smart contract payment frozen."
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        600,
        0
      ],
      "id": "notify-parties",
      "name": "Notify Driver & Customer"
    },
    {
      "parameters": {
        "amount": 24,
        "unit": "hours"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        800,
        0
      ],
      "id": "wait-24h",
      "name": "Wait 24 Hours"
    },
    {
      "parameters": {
        "url": "={{$node[\"Supabase Dispute Webhook\"].json.body.record.order_api_url}}/api/orders/{{$node[\"Supabase Dispute Webhook\"].json.body.record.id}}/status",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1000,
        0
      ],
      "id": "check-status",
      "name": "Check Dispute Resolution Status"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "value2": "disputed"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1200,
        0
      ],
      "id": "is-still-disputed",
      "name": "Is Still Disputed?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$node[\"Supabase Dispute Webhook\"].json.body.record.order_api_url}}/api/admin/escalate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "tripId",
              "value": "={{$node[\"Supabase Dispute Webhook\"].json.body.record.id}}"
            },
            {
              "name": "evidence",
              "value": "={{$node[\"Fetch GPS Trail & OTP Logs\"].json}}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1400,
        0
      ],
      "id": "escalate-admin",
      "name": "Escalate to Admin Arbitration Queue"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "manual-resolution",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "id": "manual-resolution-webhook",
      "name": "Manual Resolution Webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.body.record.order_api_url}}/api/contracts/resolve",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.INTERNAL_RELAYER_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "tripId",
              "value": "={{$json.body.record.id}}"
            },
            {
              "name": "action",
              "value": "={{$json.body.action}}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        200,
        200
      ],
      "id": "release-or-refund",
      "name": "Release or Refund Smart Contract Escrow",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "toEmail": "admin@truxify.com",
        "subject": "=Escrow Alert: Release or Refund Escrow Failed for Trip {{$json.body.record.id}}",
        "textBody": "=CRITICAL: The Release or Refund Smart Contract Escrow step failed after 3 retries for Trip {{$json.body.record.id}}. Smart contract payment was not released/refunded. Immediate manual intervention required.",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        400,
        200
      ],
      "id": "alert-admin-release-failed",
      "name": "Alert Admin — Escrow Release Failed"
    }
  ],
  "connections": {
    "webhook-trigger": {
      "main": [
        [
          {
            "node": "freeze-escrow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "freeze-escrow": {
      "main": [
        [
          {
            "node": "fetch-evidence",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "alert-admin-freeze-failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "fetch-evidence": {
      "main": [
        [
          {
            "node": "notify-parties",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "notify-parties": {
      "main": [
        [
          {
            "node": "wait-24h",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "wait-24h": {
      "main": [
        [
          {
            "node": "check-status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "check-status": {
      "main": [
        [
          {
            "node": "is-still-disputed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "is-still-disputed": {
      "main": [
        [
          {
            "node": "escalate-admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "manual-resolution-webhook": {
      "main": [
        [
          {
            "node": "release-or-refund",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "release-or-refund": {
      "main": [
        [],
        [
          {
            "node": "alert-admin-release-failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "versionId": "dispute-resolv-v2",
  "id": "dispute-resolution-pipeline"
}
