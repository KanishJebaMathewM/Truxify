with open('$BACKEND_API/src/services/escrow.js', 'r') as f:
    c = f.read()
if 'Guard: redisClient may be null' not in c:
    pattern = r'(export async function \w+\([^)]*\)\s*\{)(\s*//[^\n]*\n)*(\s*)(const \w+ = redisClient)'
    def add_guard(m):
        before = m.group(1) + m.group(2)
        indent = m.group(3)
        const_line = m.group(4)
        guard = f'{indent}// Guard: redisClient may be null when Redis is not configured\n{indent}if (!redisClient) {{\n{indent}  logger.warn(\"[Escrow] redisClient not configured - operating without cache\");\n{indent}}}\n'
        return before + guard + indent + const_line
    new_c = re.sub(pattern, add_guard, c)
    if new_c != c:
        with open('$BACKEND_API/src/services/escrow.js', 'w') as f:
            f.write(new_c)
        print('Guard applied')
    else:
        print('Pattern not matched')
else:
