
/# Development environment (local services)

ENV=dev
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-local-supabase-anon-key
TRUXIFY_API_BASE_URL=http://localhost:5000
ML_ENGINE_URL=http://localhost:8000
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology

class Env {
  // Core Environment

  static const String apiBaseUrl = String.fromEnvironment(
  'TRUXIFY_API_BASE_URL',
  defaultValue: 'http://localhost:5000',
);

  static bool get isDev => environment == 'dev';

  static bool get isStaging => environment == 'staging';

  static bool get isProd => environment == 'prod';

  // Supabase Configuration

  static const String supabaseUrl = String.fromEnvironment(
    'SUPABASE_URL',
    defaultValue: 'http://localhost:54321',
  );

  static const String supabaseAnonKey = String.fromEnvironment(
    'SUPABASE_ANON_KEY',
    defaultValue: '',
  );

  // Backend API Configuration

  static const String apiBaseUrl = String.fromEnvironment(
    'TRUXIFY_API_BASE_URL',
    defaultValue: 'http://localhost:5000',
  );

  // ML Engine Configuration

  static const String mlEngineUrl = String.fromEnvironment(
    'ML_ENGINE_URL',
    defaultValue: 'http://localhost:8000',
  );

  // Polygon / Blockchain Configuration

  static const String polygonRpcUrl = String.fromEnvironment(
    'POLYGON_RPC_URL',
    defaultValue: 'https://rpc-amoy.polygon.technology',
  );

  // Crash Reporting Configuration

  static const String sentryDsn = String.fromEnvironment(
    'SENTRY_DSN',
    defaultValue: '',
  );

  static bool get isCrashReportingEnabled =>
      sentryDsn.isNotEmpty;

  // Configuration Validation

  static void validate() {
    final errors = <String>[];

    if (supabaseUrl.isEmpty) {
      errors.add('SUPABASE_URL is not set');
    }

    if (supabaseAnonKey.isEmpty) {
      errors.add('SUPABASE_ANON_KEY is not set');
    }

    if (apiBaseUrl.isEmpty) {
      errors.add('TRUXIFY_API_BASE_URL is not set');
    }

    if (errors.isNotEmpty) {
      throw Exception(
        '\n\n'
        '═══════════════════════════════════════════════════════════\n'
        '  Truxify Config Error — Missing --dart-define values:\n'
        '═══════════════════════════════════════════════════════════\n'
        '${errors.map((e) => '  ❌ $e').join('\n')}\n'
        '\n'
        '  Run with:\n'
        '  flutter run --dart-define=ENV=dev \\\n'
        '              --dart-define=SUPABASE_URL=http://localhost:54321 \\\n'
        '              --dart-define=SUPABASE_ANON_KEY=your-local-key \\\n'
        '              --dart-define=TRUXIFY_API_BASE_URL=http://localhost:5000\n'
        '═══════════════════════════════════════════════════════════\n',
      );
    }

    // Warn if development mode points to a production Supabase URL.

    if (isDev &&
        supabaseUrl.contains('supabase.co') &&
        !supabaseUrl.contains('staging')) {
      // ignore: avoid_print
      print(
        '\n⚠️ WARNING: You are in DEV mode but SUPABASE_URL '
        'points to a non-local Supabase instance. '
        'This may be production!\n',
      );
    }
  }
}
