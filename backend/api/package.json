  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.29.1",
    "globals": "^17.12.0",
    "nodemon": "^3.1.2",
    "supertest": "^7.3.1",
