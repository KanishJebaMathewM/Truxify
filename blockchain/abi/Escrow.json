.global-search-result {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px 15px;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.2s ease;
}

.global-search-result:hover,
.global-search-result.active {
  background: var(--search-hover-bg, #f1f5f9);
}

.global-search-result strong {
  font-size: 14px;
}

.global-search-result span,
.global-search-result small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.global-search-loading,
.global-search-empty,
.global-search-error {
  padding: 14px;
  font-size: 13px;
}

.global-search-error {
  color: #dc2626;
}

.global-search-retry {
  margin-left: 10px;
  cursor: pointer;
}
