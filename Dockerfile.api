
# ==========================================
# Truxify API - Root Context Dockerfile
# ==========================================
# Build command:
# docker build -t truxify/api:latest -f Dockerfile.api .

FROM node:20-alpine

# Set application working directory
WORKDIR /app

# Create a non-root user for security
RUN addgroup -g 1001 -S appgroup \
    && adduser -S appuser -u 1001 -G appgroup

# Copy API package configuration
COPY backend/api/package.json ./

# Install production dependencies
# npm install is used because the project has no committed package-lock.json.
RUN npm install --omit=dev --legacy-peer-deps

# Copy required application directories
# Preserve the repository structure for relative imports.
COPY --chown=appuser:appgroup backend ./backend
COPY --chown=appuser:appgroup ebpf ./ebpf
COPY --chown=appuser:appgroup wasi ./wasi
COPY --chown=appuser:appgroup wasm ./wasm
COPY --chown=appuser:appgroup snyk ./snyk
COPY --chown=appuser:appgroup database/liquibase ./database/liquibase

# Environment variables and secrets must be supplied at runtime.
# Do not copy .env files into the image.

# Run the application as a non-root user
USER appuser

# Expose API port
EXPOSE 5000

# Configure container health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["node", "-e", "fetch('http://localhost:5000/api/health/live').then(r => { if (!r.ok) throw new Error('Health check failed') }).catch(() => process.exit(1))"]

# Start the API server
CMD ["node", "backend/api/src/index.js"]

