# Example snippet for k8s/deployements/api-deployement.yaml & ml-deployements.yaml
spec:
  template:
    metadata:
      annotations:
        sidecar.istio.io/rewriteAppHTTPProbers: "true"
      labels:
        app: truxify
    spec:
      containers:
        - name: api
          # ... probe definitions remain clean plaintext HTTP as kubelet expects
          livenessProbe:
            httpGet:
              path: /api/health/live
              port: 4000
