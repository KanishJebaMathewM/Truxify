
{
  "name": "truxify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "backend/api",
    "blockchain"
  ],
  "overrides": {
    "lodash-es": "4.18.1",
    "undici": "^5.14.0",
    "uuid": "^11.1.1",
    "protobufjs": "^7.5.4",
    "elliptic": "^6.6.1",
    "circuit-breaker-js": "0.0.1",
    "tslib": "2.8.1"
  },
  "scripts": {
    "prepare": "husky || echo 'Husky unavailable - skipping Git hook installation'",
    "unassign:issues": "node .github/scripts/issue-unassigner.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "audit": "npm audit",
    "check": "npm run format:check && npm run lint && npm run test"
  },
  "lint-staged": {
    "backend/**/*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "blockchain/**/*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/**/*.dart": [
      "dart format"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/mocha": "^10.0.10",
    "ethers": "^6.17.0",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^2.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2"
  },
  "dependencies": {
    "dataloader": "^2.2.3",
    "memory-pager": "^1.5.0"
  }
}
